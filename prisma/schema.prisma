generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  User
}

enum CategoryType {
  Asosiy_taomlar
  Salatlar
  Ichimliklar
  Desertlar
  Lavashlar
  Sho_rvalar
  Bolalar_menyusi
  Qoshimchalar
}

enum PaymentMethod {
  Cash
  Card
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  password  String
  role      UserRole @default(User)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id       String       @id @default(uuid())
  name     String       @unique
  type     CategoryType
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  description String?
  image       String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String        @id @default(uuid())
  // User relation olib tashlanadi — ixtiyoriy bo'ladi
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  // Mehmon uchun yangi fieldlar
  fullName      String
  phone         String
  address       String
  totalPrice    Float
  paymentMethod PaymentMethod @default(Cash)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int     @default(1)
  price     Float
}
